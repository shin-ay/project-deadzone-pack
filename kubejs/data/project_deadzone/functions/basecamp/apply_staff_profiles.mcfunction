# Minato: calm and methodical job coordinator.
execute as @e[type=easy_npc:humanoid,tag=dz_basecamp_job_guide] run data merge entity @s {CustomName:'{"text":"ミナト｜JOB管理官","color":"light_purple"}',ActionData:{ActionEventSet:{ON_INTERACTION:[{Type:"OPEN_DEFAULT_DIALOG"}]},ActionPermissionLevel:0},DialogData:{DialogDataSet:[{Label:"default",Name:"配属手続き",Texts:[{Text:"生き残るだけなら、肩書きは必要ない。だが仲間と生き残るなら、自分の役割を知っておけ。\\n\\n焦らなくていい。装備と得意分野を見て、君に合うJOBを選ぼう。"}]}],Type:"BASIC"},ModelData:{DefaultPose:"STANDING",Pose:"CUSTOM",Position:{},Rotation:{LeftArm:[-0.35f,0.12f,0.0f,0.0f],RightArm:[-0.35f,-0.12f,0.0f,0.0f]},Scale:{},Visible:{}}}

# Rei: terse, vigilant radio operator; one hand stays near the headset.
execute as @e[type=easy_npc:humanoid,tag=dz_basecamp_radio] run data merge entity @s {CustomName:'{"text":"レイ｜周波数107.3","color":"aqua"}',ActionData:{ActionEventSet:{ON_INTERACTION:[{Type:"OPEN_DEFAULT_DIALOG"}]},ActionPermissionLevel:0},DialogData:{DialogDataSet:[{Label:"default",Name:"無線連絡",Texts:[{Text:"……静かに。今、北側の周波数を拾っている。\\n\\n外へ出るなら無線を確認して。救難信号と罠は、声だけでは区別できない。戻ったら君が見たものを報告して。"}]}],Type:"BASIC"},ModelData:{DefaultPose:"STANDING",Pose:"CUSTOM",Position:{},Rotation:{LeftArm:[-0.28f,0.0f,0.0f,0.0f],RightArm:[-1.75f,-0.18f,0.18f,0.0f]},Scale:{},Visible:{}}}

# Hank: upbeat former security officer and buddy recruiter.
execute as @e[type=easy_npc:humanoid,tag=dz_basecamp_buddy_recruiter] run data merge entity @s {CustomName:'{"text":"ハンク｜Buddy募集担当","color":"aqua"}',ActionData:{ActionEventSet:{ON_INTERACTION:[{Type:"OPEN_DEFAULT_DIALOG"}]},ActionPermissionLevel:0},DialogData:{DialogDataSet:[{Label:"default",Name:"同行者の募集",Texts:[{Text:"一人で全部やるつもりか？　悪いことは言わん、背中を預けられる相棒を連れていけ。\\n\\n腕前だけじゃなく、無事に連れて帰れる相手を選べよ。ここでは生還までが契約だ。"}]}],Type:"BASIC"},ModelData:{DefaultPose:"STANDING",Pose:"CUSTOM",Position:{},Rotation:{LeftArm:[-0.65f,0.22f,-0.08f,0.0f],RightArm:[-0.82f,-0.25f,0.08f,0.0f]},Scale:{},Visible:{}}}

# Maya: warm but practical quartermaster for food and water.
execute as @e[type=easy_npc:humanoid,tag=dz_basecamp_trader_food] run data merge entity @s {CustomName:'{"text":"マヤ｜食料・水補給","color":"yellow"}',ActionData:{ActionEventSet:{ON_INTERACTION:[{Type:"OPEN_DEFAULT_DIALOG"}]},ActionPermissionLevel:0},DialogData:{DialogDataSet:[{Buttons:[{Actions:[{ExecAsUser:1b,PermLevel:0,Type:"OPEN_TRADING_SCREEN"}],Label:"open_trade",Name:"物資を確認する"},{Actions:[{Cmd:"/deadzonepeople maya",ExecAsUser:1b,PermLevel:0,Type:"COMMAND"}],Label:"personal_service",Name:"信頼と遠征配給を確認する"}],Label:"default",Name:"今日の配給",Texts:[{Text:"空腹を根性でごまかすのは三流よ。水と食料は、弾薬より先に確認しなさい。\\n\\n余った物資も持ってきて。誰かの余り物が、別の誰かの一日になるから。"}]}],Type:"CUSTOM"},Offers:{Inventory:{},Recipes:{Recipes:[{buy:{Count:1b,id:"minecraft:emerald"},buyB:{},demand:0,maxUses:64,priceMultiplier:0.0f,rewardExp:0b,sell:{Count:4b,id:"minecraft:bread"},specialPrice:0,uses:0,xp:0}]}},TradingData:{TradingDataSet:{LastReset:0L,MaxUses:64,ResetsEveryMin:30,RewardedXP:0,Type:"BASIC"}},ModelData:{DefaultPose:"STANDING",Pose:"CUSTOM",Position:{},Rotation:{LeftArm:[-0.48f,0.1f,0.0f,0.0f],RightArm:[-0.95f,-0.12f,0.0f,0.0f]},Scale:{},Visible:{}}}

