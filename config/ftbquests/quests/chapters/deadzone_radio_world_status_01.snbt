			subtitle: "解放条件: Gas Stationを確保し、キャンプへ帰還"
			tasks: [{ id: "6D8F010000002102", title: "ストーリー解禁S1へ到達", type: "custom" }]
			title: "T1報告：燃料ルート復旧"
