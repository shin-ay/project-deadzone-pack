	quests: [
		{
			description: [
				"Createの装置は文章だけで覚える必要はない。アイテムにカーソルを合わせ、Ponderキーを押すと動く見本を確認できる。"
				"まず歯車をJEIで探し、Ponderを開いて回転の伝わり方を最後まで見よう。キーが競合している場合は、操作設定で「Ponder」を検索して変更する。"
			]
			icon: "create:goggles"
			id: "6D44010000000101"
			rewards: [{
				count: 4
				id: "6D44010000001101"
				item: "minecraft:bread"
				type: "item"
			}]
			tasks: [{
				id: "6D44010000002101"
				title: "歯車のPonderを確認した"
				type: "checkmark"
			}]
			title: "01：動く説明書・Ponder"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["6D44010000000101"]
			description: [
				"JEIでアイテムを左クリックすると作り方、右クリックすると使用先を確認できる。"
				"Createでは普通の作業台レシピだけでなく、粉砕・圧縮・混合など機械別のタブも表示される。安山岩合金のレシピと使用先を両方確認しよう。"
			]
			icon: "create:andesite_alloy"
			id: "6D44010000000102"
			rewards: [{
				count: 4
				id: "6D44010000001201"
				item: "create:zinc_nugget"
				type: "item"
			}]
			subtitle: "解放条件: 「01：動く説明書・Ponder」を完了"
			tasks: [{
				id: "6D44010000002201"
				title: "安山岩合金のレシピと使用先を確認した"
				type: "checkmark"
			}]
			title: "02：JEIでレシピを読む"
			x: 2.0d
			y: 0.0d
		}
		{
			dependencies: ["6D44010000000102"]
			description: [
				"安山岩合金はCreateの基礎素材。鉄または亜鉛と安山岩を組み合わせて作る。"
				"最初は2個だけ作ればよい。大量生産は回転機械を理解してからでOK。"
			]
			icon: "create:andesite_alloy"
			id: "6D44010000000103"
			rewards: [{
				count: 2
				id: "6D44010000001301"
				item: "create:andesite_alloy"
				type: "item"
			}]
			subtitle: "解放条件: 「02：JEIでレシピを読む」を完了"
			tasks: [{
				count: 2L
				id: "6D44010000002301"
				item: "create:andesite_alloy"
				type: "item"
			}]
			title: "03：最初の安山岩合金"
			x: 4.0d
			y: 0.0d
		}
		{
			dependencies: ["6D44010000000103"]
			description: [
				"軸は回転を直線上へ運ぶ部品。軸同士は向きを合わせて設置する。"
				"設置後に手回しクランクを端へ付けると、軸が回ることを目で確認できる。今は装置へ接続しなくてよい。"
			]
			icon: "create:shaft"
			id: "6D44010000000104"
			rewards: [{
				count: 4
				id: "6D44010000001401"
				item: "create:shaft"
				type: "item"
			}]
			subtitle: "解放条件: 「03：最初の安山岩合金」を完了"
			tasks: [{
				count: 4L
				id: "6D44010000002401"
				item: "create:shaft"
				type: "item"
			}]
			title: "04：軸で回転を運ぶ"
			x: 6.0d
			y: 0.0d
		}
		{
			dependencies: ["6D44010000000104"]
			description: [
				"小歯車を軸の側面へ噛み合わせると、回転方向を90度変えられる。隣り合う歯車は逆方向へ回る。"
				"大歯車と小歯車を噛み合わせると速度が変わるが、速くするほど装置が使える負荷の余裕は減る。"
			]
			icon: "create:cogwheel"
