					type: "item"
				}
			]
			subtitle: "解放条件: 「04：軸で回転を運ぶ」を完了"
			tasks: [
				{
					count: 2L
					id: "6D44010000002501"
					item: "create:cogwheel"
					type: "item"
				}
				{
					id: "6D44010000002502"
					item: "create:large_cogwheel"
					type: "item"
				}
