{
	default_hide_dependency_lines: false
	default_quest_shape: "circle"
	filename: "deadzone_buddy_operations_01"
	group: "2492E280835EEAE3"
	icon: "simpleenemymod:recruit_table"
	id: "6D57010000000001"
	order_index: 3
	quest_links: [ ]
	quests: [
		{
			description: [
				"1人目のBuddyは単独遠征を支える専属同行者。追加のPMC契約兵と組み合わせ、車列や侵攻へ対抗する小隊を編成できる。"
				"Survivor Campの募集担当ハンクと話し、隣のRecruit Tableを使う。契約上限はStory Tierに応じて3・5・7名へ拡張される。"
				"雇用後はハンクの会話画面から役割変更・追従・待機・呼び戻しを操作できる。"
			]
			icon: "simpleenemymod:recruit_table"
			id: "6D57010000000101"
			title: "Buddy・PMC契約部隊"
			x: 0.0d
			y: 0.0d
		}
		{
			description: [
				"Recruit Tableを使い、募集名簿から同行者を雇用する。募集には鉄インゴット12個を用意する。"
				"1人目は専属Buddy、2人目以降は一般契約兵になる。上限到達時は募集が停止され、死亡した兵士の枠は再び利用できる。"
			]
			icon: "minecraft:iron_ingot"
			id: "6D57010000000102"
			title: "ハンクとRecruit Table"
			x: 2.0d
			y: -2.0d
		}
		{
			description: [
				"ASSAULT：前衛。HP・防御と攻撃性能のバランスが良い。"
				"SUPPORT：重装支援。周囲の味方へResistanceを付与する。"
				"SCOUT：高速偵察。周囲の敵を発光させ、夜間視界を確保する。"
				"MEDIC：衛生兵。味方を回復し、条件を満たすとダウンした雇用主を救助する。"
			]
			icon: "minecraft:spyglass"
			id: "6D57010000000103"
			title: "4つの役割"
			x: 2.0d
			y: 0.0d
		}
		{
			description: [
				"FOLLOWは同行、HOLDは現在地待機、RECALLは近くへ呼び戻す命令。すべてハンクの会話画面から実行できる。"
				"Buddyは予備弾薬を実際に消費し、弾切れになると射撃を停止する。ハンクの緊急在庫や補給を利用しよう。"
				"Story Unlockが進むと役割装備と生存性能が更新される。"
			]
			icon: "minecraft:compass"
			id: "6D57010000000104"
			title: "命令・補給・成長"
			x: 2.0d
			y: 2.0d
		}
		{
			description: [
				"MEDIC Buddyが近距離かつ視線内にいて、雇用主の所持品に包帯があれば、PlayerReviveのDown状態から5秒で救助する。"
				"他プレイヤーによる蘇生、Medical Revive、Second Windが優先される。救助後はStory段階別のクールダウンが発生する。"
				"救助中にBuddyと離れる、視線を切る、包帯を失うと成立しない。遠征前にハンクから状態を確認しよう。"
			]
			icon: "legendarysurvivaloverhaul:bandage"
			id: "6D57010000000105"
			title: "MEDICの緊急救助"
			x: 4.0d
			y: 0.0d
		}
		{
			description: [
				"専属Buddyは特殊能力を持つ1名の相棒。追加契約兵はCombined Arms純正の一般PMCとして扱い、Buddyの役割能力や自動Recallは持たない。"
				"契約枠はStory Tier 0～1で3名、Tier 2～3で5名、Tier 4以降は最大7名。未読込や別ディメンションの兵士も契約枠へ数える。"
				"車列・侵攻・車両守備隊へ対抗できる最小分隊を3名とし、Story進行で車両クルーと歩兵を両立できる規模へ拡張する。死亡した兵士の枠は自動的に空く。"
			]
			icon: "simpleenemymod:pmc_unit_spawn_egg"
			id: "6D57010000000106"
			title: "小隊契約枠"
			x: 4.0d
			y: -2.0d
		}
		{
			description: [
				"Tactical Data Terminalは、所有するBuddy・契約歩兵・PMC指揮官を選択してまとめて指揮するCombined Arms純正端末。"
				"追従、待機、移動、射撃許可、目標指定、車両搭乗、護衛、巡回、捜索殲滅、塹壕配置などを命令できる。"
				"Recipeはガラス板、ラピスラズリ、鉄インゴット。単独Buddyの操作にも使える。"
			]
			icon: "tacz_sewv:tactical_data_terminal"
			id: "6D57010000000107"
			title: "戦術データ端末"
			x: 6.0d
			y: -2.0d
		}
		{
			description: [
				"Story Tier 2以降、追加契約歩兵へMedal of Honorを使用するとPMC指揮官へ昇進できる。専属Buddyは役割能力を維持するため昇進対象外。"
				"指揮官へ歩兵や車両クルーを編入すると、小隊単位の自動命令と編隊行動を利用できる。"
				"Medalは赤色の羊毛2、黒色の羊毛1、金インゴット1で作成する。"
			]
			icon: "tacz_sewv:medal_of_honor"
			id: "6D57010000000108"
			title: "PMC指揮官への昇進"
			x: 6.0d
			y: 0.0d
		}
		{
			description: [
				"契約兵はTactical Data Terminalから車両へ搭乗させ、操縦手・砲手・随伴歩兵として運用できる。"
				"放棄車両は低耐久のため、確保後に修理・補給してから部隊へ編入する。敵勢力車両の近くには護衛が残っている。"
				"航空・海上部隊や火力支援も同じ所有者・勢力判定を使うが、イベントChunk LoadingはPDZ設定で無効化している。"
			]
			icon: "superbwarfare:repair_tool"
			id: "6D57010000000109"
			title: "車両クルーと機動部隊"
			x: 6.0d
			y: 2.0d
		}
	]
	title: "Buddy・PMC契約部隊"
}
