{
	chapter.D34D210000000001.title: "メインストーリー I：沈黙した街"
	chapter_group.D34D200000000001.title: "PROJECT DEADZONE"
	quest.D34D210000000010.quest_subtitle: "周波数107.3は、まだ同じ言葉を繰り返している。"
	quest.D34D210000000010.title: "Chapter 0：最後の放送"
	quest.D34D210000000020.quest_subtitle: "自分の役割を選び、最初の装備を受け取る。"
	quest.D34D210000000020.title: "生き残るための役割"
	quest.D34D210000000030.quest_subtitle: "避難所の人々と、最初の協力者を確認する。"
	quest.D34D210000000030.title: "Survivor Camp"
	quest.D34D210000000050.quest_subtitle: "水、食料、医療品を準備して街へ向かう。"
	quest.D34D210000000050.title: "探索準備"
	quest.D34D210000000060.quest_subtitle: "Raidersの偵察隊が燃料輸送路を監視している。"
	quest.D34D210000000060.title: "Gas Stationを確保せよ"
	quest.D34D210000000070.quest_subtitle: "燃料と周辺地図を避難所へ持ち帰る。"
	quest.D34D210000000070.title: "T1：Survivor"
	quest.D34D210000000080.quest_subtitle: "地図には武器店と警察署を結ぶ補給経路がある。"
	quest.D34D210000000080.title: "Chapter 2：沈黙した街"
	quest.D34D210000000090.quest_subtitle: "Raider Enforcerが武器供給拠点を守っている。"
	quest.D34D210000000090.title: "Gun Shop制圧"
	quest.D34D2100000000A0.quest_subtitle: "壊れた警察無線に、最後の救難信号が残っていた。"
	quest.D34D2100000000A0.title: "残された通信記録"
	quest.D34D2100000000B0.quest_subtitle: "警察署はRaider Wardenの要塞になっている。"
	quest.D34D2100000000B0.title: "Chapter 3：失われた法"
	quest.D34D2100000000C0.quest_subtitle: "留置区画、通信室、証拠保管庫を順に確保する。"
	quest.D34D2100000000C0.title: "Police Station突入"
	quest.D34D2100000000D0.quest_subtitle: "Raider Wardenを倒し、都市に残された道を開く。"
	quest.D34D2100000000D0.title: "T2：Scavenger"
	task.D34D210000000011.title: "途切れた放送を確認した"
